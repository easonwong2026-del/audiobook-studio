{
  "schema_version": "audiobook-tts-profile-v1",
  "revision": 1,
  "profile_id": "indextts2-rtx5070ti-laptop-12gb-v1",
  "status": "provisional-unbenchmarked",
  "engine": "indextts2",
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 5070 Ti Laptop GPU",
    "vram_gb": 12,
    "platform": "windows"
  },
  "options": {
    "fp16": true,
    "deepspeed": false,
    "cuda_kernel": false,
    "accel": false,
    "torch_compile": false
  },
  "limits": {
    "metric": "tokens",
    "preferred": 80,
    "maximum": 100,
    "absolute": 120,
    "minimum": 16,
    "fallback_chars": 70,
    "max_fallback_chars": 100
  },
  "splitting": {
    "allow_merge": true,
    "split_priority": [
      "paragraph",
      "sentence",
      "semicolon",
      "comma",
      "colon",
      "safe_character"
    ],
    "max_retry_split_depth": 3
  },
  "emotion": {
    "mode": "text_auto",
    "use_emo_text": true,
    "emo_alpha": 0.55,
    "use_random": false
  },
  "runtime": {
    "concurrency": 1,
    "oom_retry": true,
    "clear_cache_after_oom": true,
    "oom_recovery": true,
    "oom_split_ratio": 0.6,
    "max_split_depth": 3,
    "min_retry_tokens": 12,
    "clear_cuda_cache": true,
    "restart_engine_after_tasks": 100,
    "vram_growth_limit_mb": 1536,
    "minimum_free_vram_mb": 1536
  }
}
