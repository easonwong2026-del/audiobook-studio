{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-script-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patches"],
  "properties": {
    "schema_version": {"const": "ai-script-review-v1"},
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "action", "speaker_id", "segment_type", "confidence", "reason"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["reassign", "unresolve", "reclassify"]},
          "speaker_id": {"type": ["string", "null"]},
          "segment_type": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
