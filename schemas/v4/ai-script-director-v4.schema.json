{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-script-director-v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter_id", "source_start", "source_end", "segments"],
  "properties": {
    "schema_version": {"const": "ai-script-director-v4"},
    "chapter_id": {"type": "string", "minLength": 1},
    "source_start": {"type": "integer", "minimum": 0},
    "source_end": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_start", "source_end", "segment_type", "speaker_id", "text", "confidence"],
        "properties": {
          "source_start": {"type": "integer", "minimum": 0},
          "source_end": {"type": "integer", "minimum": 1},
          "segment_type": {"enum": ["narration", "dialogue", "inner_monologue", "quotation", "stage_direction"]},
          "speaker_id": {"type": ["string", "null"]},
          "text": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "emotion": {"type": "string"},
          "emotion_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "delivery": {"type": "object"},
          "pause_before": {"type": "integer", "minimum": 0},
          "pause_after": {"type": "integer", "minimum": 0},
          "pauses": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
