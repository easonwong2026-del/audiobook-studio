{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-consolidation-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "chapter_candidates", "existing_speakers"],
  "properties": {
    "schema_version": {"const": "character-consolidation-request-v1"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chapter_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "name", "aliases", "confidence", "evidence", "source", "status"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chapter_id", "text"],
              "properties": {
                "chapter_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          },
          "source": {"enum": ["rule", "ai", "manual"]},
          "status": {"enum": ["candidate", "confirmed", "rejected"]}
        }
      }
    },
    "existing_speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker_id", "name", "aliases", "locked"],
        "properties": {
          "speaker_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "locked": {"type": "boolean"}
        }
      }
    }
  }
}
